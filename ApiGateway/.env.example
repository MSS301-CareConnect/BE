# Export these variables in your shell/IDE. Spring Boot does not automatically read .env.

# Application / API documentation
GATEWAY_SERVER_PORT=
# Swagger tổng hợp tại /swagger-ui.html (đọc /v3/api-docs của từng service qua route /api-docs/*).
GATEWAY_SWAGGER_ENABLED=

# Service phía sau (không có service discovery). Gateway giữ nguyên path /api/v1/** khi chuyển tiếp (không cắt prefix).
GATEWAY_IDENTITY_URL=
GATEWAY_CARE_RECIPIENT_URL=
GATEWAY_BOOKING_URL=
GATEWAY_PROVIDER_URL=
GATEWAY_CARE_CATALOG_URL=
GATEWAY_MEDIA_URL=

# Timeout gọi service phía sau (Duration: 2s, 500ms…). Quá read-timeout → 504 (code 9003).
GATEWAY_CONNECT_TIMEOUT=
GATEWAY_READ_TIMEOUT=

# JWT do IdentityService phát — gateway chỉ kiểm sớm (service phía sau vẫn tự kiểm).
# ISSUER phải khớp chính xác IDENTITY_JWT_ISSUER. Audience cố định "careconnect-api" (không cấu hình).
GATEWAY_JWT_ISSUER=
GATEWAY_JWT_JWKS_URI=

# CORS tập trung tại gateway (credentials = cookie). Danh sách origin FE, phân tách bằng dấu phẩy, không dùng *.
GATEWAY_ALLOWED_ORIGINS=
