# Application
PROVIDER_SERVER_PORT=8084
PROVIDER_SWAGGER_ENABLED=true
# Origin của ApiGateway (không kèm /api/v1 — path controller đã có version) để Swagger "Try it out" gọi qua gateway. Bỏ trống khi chạy độc lập.
PROVIDER_OPENAPI_SERVER_URL=

# PostgreSQL
PROVIDER_DB_NAME=CARECONNECT_PROVIDER
PROVIDER_DB_URL=jdbc:postgresql://localhost:5444/CARECONNECT_PROVIDER
PROVIDER_DB_PORT=5444
PROVIDER_DB_USERNAME=postgres
PROVIDER_DB_PASSWORD=

# JWT do IdentityService phát
PROVIDER_JWT_ISSUER=
PROVIDER_JWT_JWKS_URI=http://localhost:8081/.well-known/jwks.json

# Provider gọi IdentityService
PROVIDER_IDENTITY_URL=http://localhost:8080
PROVIDER_IDENTITY_CONNECT_TIMEOUT_MS=2000
PROVIDER_IDENTITY_READ_TIMEOUT_MS=3000

# Provider gọi MediaService
PROVIDER_MEDIA_URL=http://localhost:8080

PROVIDER_MEDIA_CONNECT_TIMEOUT_MS=3000
PROVIDER_MEDIA_READ_TIMEOUT_MS=30000

# Provider gọi CareCatalogService qua ApiGateway (kiểm offering khi gán kỹ năng caregiver)
PROVIDER_CARE_CATALOG_URL=http://localhost:8080
PROVIDER_CARE_CATALOG_CONNECT_TIMEOUT_MS=2000
PROVIDER_CARE_CATALOG_READ_TIMEOUT_MS=3000

# Provider gọi BookingService qua ApiGateway (caregiver bận — C5.1)
PROVIDER_BOOKING_URL=http://localhost:8080
PROVIDER_BOOKING_CONNECT_TIMEOUT_MS=2000
PROVIDER_BOOKING_READ_TIMEOUT_MS=3000

# Danh tính máy của ProviderService để xin token SERVICE (POST /api/v1/auth/service-token qua PROVIDER_IDENTITY_URL).
# IdentityService giữ BCrypt hash trong IDENTITY_SERVICE_CLIENTS (sinh bằng IdentityService/scripts/New-ServiceClient.ps1 provider).
PROVIDER_SERVICE_CLIENT_ID=
PROVIDER_SERVICE_CLIENT_SECRET=
PROVIDER_SERVICE_TOKEN_CONNECT_TIMEOUT=2s
PROVIDER_SERVICE_TOKEN_READ_TIMEOUT=3s
