# Export các biến môi trường này trước khi chạy CareCatalogService.

# Application / API documentation
CARE_CATALOG_SERVER_PORT=8083
CARE_CATALOG_SWAGGER_ENABLED=true
# Khi chạy sau ApiGateway: /api/v1 để Swagger "Try it out" gọi qua gateway. Bỏ trống khi chạy độc lập.
CARE_CATALOG_OPENAPI_SERVER_URL=/api/v1

# PostgreSQL riêng của service (CARE_CATALOG_DB_PORT dùng cho Docker Compose)
CARE_CATALOG_DB_NAME=CARECONNECT_CATALOG
CARE_CATALOG_DB_URL=jdbc:postgresql://localhost:5443/CARECONNECT_CATALOG
CARE_CATALOG_DB_PORT=5443
CARE_CATALOG_DB_USERNAME=postgres
CARE_CATALOG_DB_PASSWORD=

# JWT do IdentityService phát — service này chỉ XÁC MINH (public key qua JWKS, không giữ private key).
# ISSUER phải khớp chính xác IDENTITY_JWT_ISSUER của IdentityService.
CARE_CATALOG_JWT_ISSUER=http://localhost:8081
# JWKS gọi TRỰC TIẾP IdentityService (gateway không công bố /.well-known/jwks.json).
CARE_CATALOG_JWT_JWKS_URI=http://localhost:8081/.well-known/jwks.json

# Feign -> IdentityService (service-to-service, không qua gateway)
CARE_CATALOG_IDENTITY_URL=http://localhost:8081
# Phải bằng IDENTITY_INTERNAL_SECRET của IdentityService.
CARE_CATALOG_IDENTITY_INTERNAL_SECRET=
CARE_CATALOG_IDENTITY_CONNECT_TIMEOUT_MS=2000
CARE_CATALOG_IDENTITY_READ_TIMEOUT_MS=3000

# Secret cho /internal/care-catalog/** của service này (Booking… gọi vào), header X-Internal-Secret.
# Bỏ trống = khóa toàn bộ /internal/**. Chuỗi ngẫu nhiên dài (>= 32 ký tự), không commit giá trị thật.
CARE_CATALOG_INTERNAL_SECRET=
