# Export these variables in your shell/IDE. Spring Boot does not automatically read .env.

# Application / API documentation
IDENTITY_SERVER_PORT=8081
IDENTITY_SWAGGER_ENABLED=true

# PostgreSQL (IDENTITY_DB_PORT is used by Docker Compose)
# IDENTITY_DB_NAME is the DB created by Compose on a fresh volume; match it in the URL.
IDENTITY_DB_NAME=CARECONNECT_IDENTITY
IDENTITY_DB_URL=jdbc:postgresql://localhost:5441/CARECONNECT_IDENTITY
IDENTITY_DB_PORT=5441
IDENTITY_DB_USERNAME=careconnect_identity
IDENTITY_DB_PASSWORD=replace_me

# Redis
IDENTITY_REDIS_HOST=localhost
IDENTITY_REDIS_PORT=6381
IDENTITY_REDIS_PASSWORD=

# JWT - danh tính bên phát token, bên nhận token và cặp khóa RSA dùng ký RS256.
# JWT ở service này được ký, không mã hóa nội dung; không đưa secret vào payload.
# Claim iss/aud: https://www.rfc-editor.org/rfc/rfc7519.html#section-4.1

# ISSUER = định danh IdentityService đã phát token, được ghi vào claim "iss".
# Hiện dùng http://localhost:8081 cho dev; đây là định danh, không phải URL redirect.
# Khi deploy có thể dùng URL ổn định, ví dụ https://identity.careconnect.example.
# Bên kiểm token phải cấu hình issuer khớp chính xác; khác chuỗi thì bị từ chối.
# Cấu hình này không tự tạo OAuth2/OIDC discovery endpoint.
IDENTITY_JWT_ISSUER=http://localhost:8081

# AUDIENCE = định danh API được phép nhận token, được ghi vào claim "aud".
# careconnect-identity là audience của IdentityService hiện tại, không phải role/user.
# Đây là chuỗi định danh do hệ thống quy ước, không bắt buộc là URL có thể truy cập.
# Service kiểm token yêu cầu aud chứa audience đã cấu hình; không khớp sẽ từ chối.
# Khi thêm BookingService/... cần chốt audience contract; bản này phát một audience.
IDENTITY_JWT_AUDIENCE=careconnect-identity

# KEY_ID = nhãn nhận diện cặp khóa, được ghi vào JWT header "kid" và public JWKS.
# identity-dev-1 là tên do mình đặt; không phải mật khẩu hay nội dung khóa RSA.
# Nhãn giúp bên nhận xác định public key nào dùng để kiểm chữ ký khi đọc JWKS.
# Khi đổi cặp khóa dùng key ID mới; service hiện chỉ có một cặp khóa, chưa có overlap.
# Chỉ đổi KEY_ID không sinh khóa mới và không phải cơ chế thu hồi token.
IDENTITY_JWT_KEY_ID=identity-dev-1

# PRIVATE_KEY = đường dẫn file chứa khóa riêng, IdentityService dùng để KÝ JWT.
# Giá trị này là vị trí file, không phải chuỗi mật khẩu hoặc nội dung PEM.
# file:./keys/private.pem là file trong thư mục keys/ tính từ thư mục chạy service.
# Định dạng yêu cầu: RSA private PEM PKCS8; cặp khóa phải khớp, ít nhất 2048 bit.
# Giữ file private chỉ ở IdentityService; không gửi cho frontend/service khác/commit Git.
# Deploy: trỏ tới file khóa được mount/cấp bởi môi trường triển khai.
IDENTITY_JWT_PRIVATE_KEY=file:./keys/private.pem

# PUBLIC_KEY = đường dẫn file chứa khóa công khai cùng cặp với private key ở trên.
# Service dùng để KIỂM chữ ký JWT; public key không dùng để phát token hợp lệ.
# Định dạng yêu cầu: RSA public PEM X509 (SubjectPublicKeyInfo).
# Public key được công bố dạng JWKS tại /.well-known/jwks.json cho bên nhận token.
# Đường dẫn file này là local ở IdentityService, không phải URL JWKS.
# Tạo cả hai file dev một lần bằng scripts/New-DevKeys.ps1; giữ khóa qua các lần restart.
# Nếu thay cặp khóa hiện tại, token ký bằng khóa cũ sẽ không còn được service chấp nhận.
IDENTITY_JWT_PUBLIC_KEY=file:./keys/public.pem

# Session lifetime
# Development examples, not fixed business policy. Set explicitly for deployment.
IDENTITY_ACCESS_TTL=15m
IDENTITY_REFRESH_TTL=7d

# OTP limits (development examples)
IDENTITY_OTP_TTL=5m
IDENTITY_OTP_COOLDOWN=60s
IDENTITY_OTP_MAX_ATTEMPTS=5

# Browser CORS / cookies (use Secure=true over HTTPS in production)
IDENTITY_ALLOWED_ORIGINS=http://localhost:3000
IDENTITY_COOKIE_SECURE=false
IDENTITY_COOKIE_SAME_SITE=Lax

# Brevo email delivery
BREVO_API_KEY=replace_me
BREVO_SENDER_EMAIL=replace_with_verified_sender
BREVO_SENDER_NAME=CareConnect

# Initial ADMIN account
# Enable once for a fresh DB, then disable and remove bootstrap credentials.
IDENTITY_BOOTSTRAP_ENABLED=false
IDENTITY_BOOTSTRAP_EMAIL=
IDENTITY_BOOTSTRAP_PASSWORD=
