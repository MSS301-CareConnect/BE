# Export these variables in your shell/IDE. Spring Boot does not automatically read .env.

# Application / API documentation
CARE_RECIPIENT_SERVER_PORT=
CARE_RECIPIENT_SWAGGER_ENABLED=
# Khi chạy sau ApiGateway: /api/v1 để Swagger "Try it out" gọi qua gateway. Bỏ trống khi chạy độc lập.
CARE_RECIPIENT_OPENAPI_SERVER_URL=

# PostgreSQL riêng của service (CARE_RECIPIENT_DB_PORT dùng cho Docker Compose)
# CARE_RECIPIENT_DB_NAME là DB Compose tạo khi volume còn mới; tên cuối URL phải giống.
CARE_RECIPIENT_DB_NAME=
CARE_RECIPIENT_DB_URL=
CARE_RECIPIENT_DB_PORT=
CARE_RECIPIENT_DB_USERNAME=
CARE_RECIPIENT_DB_PASSWORD=

# JWT do IdentityService phát — service này chỉ XÁC MINH (public key qua JWKS, không giữ private key).
# ISSUER phải khớp chính xác IDENTITY_JWT_ISSUER của IdentityService.
# Audience không cấu hình: luôn kiểm "careconnect-api" (audience chung của mọi service backend).
CARE_RECIPIENT_JWT_ISSUER=
# JWKS gọi TRỰC TIẾP IdentityService (gateway không công bố /.well-known/jwks.json).
CARE_RECIPIENT_JWT_JWKS_URI=

# Feign → IdentityService (/internal/users/**), không qua gateway.
CARE_RECIPIENT_IDENTITY_URL=
# Phải bằng IDENTITY_INTERNAL_SECRET của IdentityService.
CARE_RECIPIENT_IDENTITY_INTERNAL_SECRET=
CARE_RECIPIENT_IDENTITY_CONNECT_TIMEOUT_MS=
CARE_RECIPIENT_IDENTITY_READ_TIMEOUT_MS=

# Feign → BookingService (/internal/bookings/caregiver-access, quyền xem hồ sơ của caregiver), không qua gateway.
CARE_RECIPIENT_BOOKING_URL=
# Phải bằng BOOKING_INTERNAL_SECRET của BookingService.
CARE_RECIPIENT_BOOKING_INTERNAL_SECRET=
CARE_RECIPIENT_BOOKING_CONNECT_TIMEOUT_MS=
CARE_RECIPIENT_BOOKING_READ_TIMEOUT_MS=

# Secret cho /internal/care-recipients/** của service này (Booking… gọi vào), header X-Internal-Secret.
# Bỏ trống = khóa toàn bộ /internal/**. Chuỗi ngẫu nhiên dài (>= 32 ký tự), không commit giá trị thật.
CARE_RECIPIENT_INTERNAL_SECRET=
