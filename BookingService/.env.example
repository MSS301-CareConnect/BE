    # Export these variables in your shell/IDE. Spring Boot does not automatically read .env.

# Application / API documentation
BOOKING_SERVER_PORT=
BOOKING_SWAGGER_ENABLED=
# Origin của ApiGateway (không kèm /api/v1 — path controller đã có version) để Swagger "Try it out" gọi qua gateway. Bỏ trống khi chạy độc lập.
BOOKING_OPENAPI_SERVER_URL=

# PostgreSQL riêng của service (BOOKING_DB_PORT dùng cho Docker Compose)
# BOOKING_DB_NAME là DB Compose tạo khi volume còn mới; tên cuối URL phải giống.
BOOKING_DB_NAME=
BOOKING_DB_URL=
BOOKING_DB_PORT=
BOOKING_DB_USERNAME=
BOOKING_DB_PASSWORD=

# JWT do IdentityService phát — service này chỉ XÁC MINH (public key qua JWKS, không giữ private key).
# ISSUER phải khớp chính xác IDENTITY_JWT_ISSUER. Audience không cấu hình: luôn kiểm "careconnect-api".
BOOKING_JWT_ISSUER=
# JWKS gọi TRỰC TIẾP IdentityService (gateway không công bố /.well-known/jwks.json).
BOOKING_JWT_JWKS_URI=

# Feign gọi qua ApiGateway (URL của gateway, vd http://localhost:8080).
BOOKING_IDENTITY_URL=
BOOKING_IDENTITY_CONNECT_TIMEOUT_MS=
BOOKING_IDENTITY_READ_TIMEOUT_MS=

# Feign gọi qua ApiGateway (URL của gateway, vd http://localhost:8080).
BOOKING_CARE_RECIPIENT_URL=
BOOKING_CARE_RECIPIENT_CONNECT_TIMEOUT_MS=
BOOKING_CARE_RECIPIENT_READ_TIMEOUT_MS=

# Feign gọi qua ApiGateway (URL của gateway, vd http://localhost:8080).
BOOKING_PROVIDER_URL=
BOOKING_PROVIDER_CONNECT_TIMEOUT_MS=
BOOKING_PROVIDER_READ_TIMEOUT_MS=

# Quy tắc lịch (bỏ trống = mặc định đã chốt). Duration dạng 12h, 30m, PT24H.
# Múi giờ sinh buổi chăm sóc (mặc định Asia/Ho_Chi_Minh); thời điểm luôn lưu UTC.
BOOKING_TIMEZONE=
# Số buổi tối đa / booking (60) và số ngày tối đa từ ngày bắt đầu tới ngày kết thúc (90).
BOOKING_MAX_OCCURRENCES=
BOOKING_MAX_SPAN_DAYS=
# Buổi đầu phải cách lúc đặt ít nhất (12h).
BOOKING_MIN_LEAD_TIME=
# Hạn trung tâm duyệt PENDING (24h) và hạn đặt cọc sau khi chấp nhận (24h) — đều không quá giờ buổi đầu.
BOOKING_ACCEPTANCE_TIMEOUT=
BOOKING_DEPOSIT_TIMEOUT=
# Khoảng ngày tối đa một lần caregiver xem lịch (62), số booking xử lý mỗi lượt quét hết hạn (100), chu kỳ quét (5m).
BOOKING_MAX_CAREGIVER_RANGE_DAYS=
BOOKING_EXPIRY_BATCH_SIZE=
BOOKING_EXPIRY_SCAN_INTERVAL=

# Feign gọi qua ApiGateway (URL của gateway, vd http://localhost:8080).
BOOKING_CATALOG_URL=
BOOKING_CARE_CATALOG_CONNECT_TIMEOUT_MS=
BOOKING_CARE_CATALOG_READ_TIMEOUT_MS=
# Tỷ lệ đặt cọc (mặc định 0.30 = 30%)
BOOKING_DEPOSIT_RATE=

# Tích hợp CareCatalogService: false = báo giá tạm không giá; true = gọi catalog thật lấy đơn giá và thành tiền.
BOOKING_CATALOG_INTEGRATION_ENABLED=
