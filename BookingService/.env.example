# Export these variables in your shell/IDE. Spring Boot does not automatically read .env.

# Application / API documentation
BOOKING_SERVER_PORT=
BOOKING_SWAGGER_ENABLED=
# Origin của ApiGateway (không kèm /api/v1 — path controller đã có version) để Swagger "Try it out" gọi qua gateway. Bỏ trống khi chạy độc lập.
BOOKING_OPENAPI_SERVER_URL=

# PostgreSQL riêng của service (BOOKING_DB_PORT dùng cho Docker Compose)
# BOOKING_DB_NAME là DB Compose tạo khi volume còn mới; tên cuối URL phải giống.
BOOKING_DB_NAME=
BOOKING_DB_URL=
BOOKING_DB_PORT=
BOOKING_DB_USERNAME=
BOOKING_DB_PASSWORD=

# JWT do IdentityService phát — service này chỉ XÁC MINH (public key qua JWKS, không giữ private key).
# ISSUER phải khớp chính xác IDENTITY_JWT_ISSUER. Audience không cấu hình: luôn kiểm "careconnect-api".
BOOKING_JWT_ISSUER=
# JWKS gọi TRỰC TIẾP IdentityService (gateway không công bố /.well-known/jwks.json).
BOOKING_JWT_JWKS_URI=

# Feign gọi qua ApiGateway (URL của gateway, vd http://localhost:8080).
BOOKING_IDENTITY_URL=
BOOKING_IDENTITY_CONNECT_TIMEOUT_MS=
BOOKING_IDENTITY_READ_TIMEOUT_MS=

# Token SERVICE (client-credentials) xin ở IdentityService qua BOOKING_IDENTITY_URL. Secret thô ở đây; IdentityService chỉ
# giữ BCrypt hash trong IDENTITY_SERVICE_CLIENTS (sinh bằng IdentityService/scripts/New-ServiceClient.ps1 booking).
BOOKING_SERVICE_CLIENT_ID=
BOOKING_SERVICE_CLIENT_SECRET=
# Timeout xin token SERVICE (Duration, bỏ trống = 2s / 3s).
BOOKING_SERVICE_TOKEN_CONNECT_TIMEOUT=
BOOKING_SERVICE_TOKEN_READ_TIMEOUT=

# Feign gọi qua ApiGateway (URL của gateway, vd http://localhost:8080).
BOOKING_CARE_RECIPIENT_URL=
BOOKING_CARE_RECIPIENT_CONNECT_TIMEOUT_MS=
BOOKING_CARE_RECIPIENT_READ_TIMEOUT_MS=

# Feign gọi qua ApiGateway (URL của gateway, vd http://localhost:8080).
BOOKING_PROVIDER_URL=
BOOKING_PROVIDER_CONNECT_TIMEOUT_MS=
BOOKING_PROVIDER_READ_TIMEOUT_MS=

# Quy tắc lịch (bỏ trống = mặc định đã chốt). Duration dạng 12h, 30m, PT24H.
# Múi giờ sinh buổi chăm sóc (mặc định Asia/Ho_Chi_Minh); thời điểm luôn lưu UTC.
BOOKING_TIMEZONE=
# Số buổi tối đa / booking (60) và số ngày tối đa từ ngày bắt đầu tới ngày kết thúc (90).
BOOKING_MAX_OCCURRENCES=
BOOKING_MAX_SPAN_DAYS=
# L-08 (bỏ trống = mặc định): ngày bắt đầu xa nhất (90 ngày tới), thời lượng mỗi buổi tối thiểu (1h).
BOOKING_MAX_ADVANCE_DAYS=
BOOKING_MIN_OCCURRENCE_DURATION=
# Đặt trước tối thiểu, hạn xác nhận / phân công / thanh toán, cọc, hoàn tiền: nằm ở center booking policy (spec §8,
# bảng center_booking_policies). Mặc định cho trung tâm chưa cấu hình riêng (phút / %) — bỏ comment để đổi:
# BOOKING_POLICY_SHIFT_MIN_ADVANCE_MINUTES=120
# BOOKING_POLICY_RECURRING_MIN_ADVANCE_MINUTES=2880
# BOOKING_POLICY_CUSTOM_MIN_ADVANCE_MINUTES=2880
# BOOKING_POLICY_CONFIRMATION_TIMEOUT_MINUTES=1440
# BOOKING_POLICY_ASSIGNMENT_TIMEOUT_MINUTES=1440
# BOOKING_POLICY_INITIAL_PAYMENT_TIMEOUT_MINUTES=1440
# BOOKING_POLICY_REMAINING_PAYMENT_DUE_BEFORE_MINUTES=1440
# BOOKING_POLICY_REMAINING_PAYMENT_REMINDER_MINUTES=4320,2880
# BOOKING_POLICY_DEPOSIT_PERCENT=30
# BOOKING_POLICY_CHECK_IN_EARLY_MINUTES=30
# BOOKING_POLICY_CHECK_IN_LATE_MINUTES=30
# BOOKING_POLICY_REFUND_THRESHOLD_MINUTES=1440
# BOOKING_POLICY_REFUND_PERCENT_BEFORE_THRESHOLD=100
# BOOKING_POLICY_REFUND_PERCENT_AFTER_THRESHOLD=70
# BOOKING_POLICY_OVERDUE_PAYMENT_FORFEIT_PERCENT=100
# Khoảng ngày tối đa một lần caregiver xem lịch (62), số booking xử lý mỗi lượt quét hết hạn (100), chu kỳ quét (5m).
BOOKING_MAX_CAREGIVER_RANGE_DAYS=
BOOKING_EXPIRY_BATCH_SIZE=
BOOKING_EXPIRY_SCAN_INTERVAL=
# Caregiver còn xem hồ sơ người bệnh bao lâu sau khi buổi COMPLETED kết thúc (24h, BK-07).
BOOKING_CAREGIVER_ACCESS_GRACE=

# Feign gọi CareCatalogService qua ApiGateway (URL của gateway, vd http://localhost:8080). BOOKING_CARE_CATALOG_URL được
# ưu tiên; BOOKING_CATALOG_URL là tên cũ, chỉ dùng khi biến trên bỏ trống.
BOOKING_CARE_CATALOG_URL=
BOOKING_CATALOG_URL=
BOOKING_CARE_CATALOG_CONNECT_TIMEOUT_MS=
BOOKING_CARE_CATALOG_READ_TIMEOUT_MS=
# Ca chăm sóc (bỏ trống = mặc định): nhắc session quên kết thúc sau giờ kết thúc (60m); chu kỳ quét (5m);
# D21: ca quên check-out tự đóng sau giờ kết thúc + 4h. Cửa sổ check-in theo BOOKING_POLICY_CHECK_IN_* (Q12).
BOOKING_SESSION_OVERDUE_REMINDER_AFTER=
BOOKING_SESSION_OVERDUE_SCAN_INTERVAL=
BOOKING_SESSION_AUTO_CLOSE_AFTER=
# D22 / Q12 (bỏ trống = mặc định): chưa check-in sau giờ bắt đầu + check-in-late của policy → MISSED; chu kỳ quét (5m);
# D21: báo vắng trung tâm không quyết trong 24h sau giờ kết thúc → hệ thống tự chấp nhận.
# (BOOKING_NO_SHOW_REPORT_WINDOW, BOOKING_SESSION_START_WINDOW, BOOKING_MISSED_GRACE đã bỏ.)
BOOKING_MISSED_SCAN_INTERVAL=
BOOKING_NO_SHOW_DECISION_REMINDER_AFTER=

# D20 (bỏ trống = mặc định): mở khiếu nại trong 7d sau buổi; khách chuyển admin khi trung tâm chưa xử lý sau 48h.
BOOKING_COMPLAINT_OPEN_WINDOW=
BOOKING_COMPLAINT_CUSTOMER_ESCALATE_AFTER=
# H-08 / H-09: UUID tài khoản admin (Identity) nhận thông báo khiếu nại chuyển cấp + outbox FAILED, cách nhau dấu phẩy.
BOOKING_ADMIN_USER_IDS=

# booking_outbox (bỏ trống = mặc định): chu kỳ quét 30s, lô 50, tối đa 10 lần, backoff 30s → tối đa 1h, giữ dòng 2m.
BOOKING_OUTBOX_SCAN_INTERVAL=
BOOKING_OUTBOX_BATCH_SIZE=
BOOKING_OUTBOX_MAX_ATTEMPTS=
BOOKING_OUTBOX_BASE_BACKOFF=
BOOKING_OUTBOX_MAX_BACKOFF=
BOOKING_OUTBOX_CLAIM_LEASE=

# Số booking PENDING / AWAITING_DEPOSIT tối đa của một khách (mặc định 3).
BOOKING_MAX_PENDING_PER_CUSTOMER=

# Luôn gọi CareCatalogService để báo giá (BK-01); Catalog lỗi → 503, không tạo booking không giá.

# PaymentService qua ApiGateway — chính sách hiệu lực để hiển thị cọc dự kiến khi báo giá (lỗi → báo giá không có phần cọc).
# Tiền cọc thật do PaymentService quyết định, Booking không tự tính.
BOOKING_PAYMENT_URL=
BOOKING_PAYMENT_CONNECT_TIMEOUT_MS=
BOOKING_PAYMENT_READ_TIMEOUT_MS=

# BK-03: previewToken hủy booking ký HMAC. Production BẮT BUỘC đặt khóa ngẫu nhiên dài (dùng chung mọi instance); bỏ trống
# chỉ hợp lệ khi dev (khóa ngẫu nhiên theo tiến trình — token mất hiệu lực khi restart). Hạn token (10m).
BOOKING_CANCELLATION_PREVIEW_SECRET=
BOOKING_CANCELLATION_PREVIEW_TTL=

# Aftercare — Media qua gateway, nhắc ca mỗi 15 phút
BOOKING_MEDIA_URL=
BOOKING_SHIFT_REMINDER_INTERVAL=
