# Spring Boot
MEDIA_SERVER_PORT=8086
MEDIA_SWAGGER_ENABLED=true

# PostgreSQL container riêng của MediaService
MEDIA_DB_NAME=CARECONNECT_MEDIA
MEDIA_DB_PORT=5445
MEDIA_DB_URL=jdbc:postgresql://localhost:5446/CARECONNECT_MEDIA
MEDIA_DB_USERNAME=postgres
MEDIA_DB_PASSWORD=postgres

# Cloudflare R2 S3-compatible API
# Endpoint dạng https://<ACCOUNT_ID>.r2.cloudflarestorage.com
MEDIA_R2_ENDPOINT=
MEDIA_R2_BUCKET=your_bucket_name
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=
MEDIA_R2_DOWNLOAD_URL_TTL_SECONDS=300

# Secret bảo vệ /internal/media/**. Tự sinh chuỗi ngẫu nhiên >= 32 ký tự.
# Service gọi MediaService phải dùng đúng giá trị này trong header X-Internal-Secret.
MEDIA_INTERNAL_SECRET=
