# Application
AI_SERVER_PORT=8088
AI_SWAGGER_ENABLED=true

# PostgreSQL
AI_DB_NAME=CARECONNECT_AI
AI_DB_PORT=5448
AI_DB_URL=jdbc:postgresql://localhost:5448/CARECONNECT_AI
AI_DB_USERNAME=postgres
AI_DB_PASSWORD=your_postgres_password

# IdentityService JWT
AI_JWT_ISSUER=http://localhost:8081
AI_JWT_JWKS_URI=http://localhost:8081/.well-known/jwks.json

# Groq
AI_GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_GROQ_API_KEY=your_groq_api_key
AI_GROQ_MODEL=qwen/qwen3.8-27b
# Mô hình đọc ảnh chứng chỉ (phải nhận ảnh); để trống = dùng AI_GROQ_MODEL.
AI_GROQ_VISION_MODEL=
AI_GROQ_CONNECT_TIMEOUT=5s
AI_GROQ_READ_TIMEOUT=60s
AI_GROQ_TEMPERATURE=0.3
AI_GROQ_MAX_COMPLETION_TOKENS=1024

# Chat limits
AI_GUEST_DAILY_PROMPT_LIMIT=3
AI_GUEST_MAX_PROMPT_LENGTH=500
AI_CUSTOMER_MAX_PROMPT_LENGTH=2000
AI_GUEST_TIMEZONE=Asia/Ho_Chi_Minh

AI_CHAT_MAX_IMAGES=3
AI_CHAT_MAX_IMAGE_SIZE_MB=10
AI_CHAT_MAX_TOTAL_IMAGE_SIZE_MB=20
AI_CHAT_MAX_IMAGE_SIZE=10MB
AI_CHAT_MAX_REQUEST_SIZE=20MB

AI_CHAT_MAX_HISTORY_MESSAGES=20

# MediaService through API Gateway
AI_MEDIA_URL=http://localhost:8080
AI_IDENTITY_URL=http://localhost:8080

# Điền sau khi tạo service client cho AIService
AI_SERVICE_CLIENT_ID=
AI_SERVICE_CLIENT_SECRET=

# Kiểm tra chứng chỉ bằng AI
AI_CERTIFICATE_MAX_IMAGES=5
AI_CERTIFICATE_TEMPERATURE=0.0
AI_CERTIFICATE_TIMEZONE=Asia/Ho_Chi_Minh
