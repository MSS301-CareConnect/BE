PAYMENT_SERVER_PORT=8087
PAYMENT_DB_PORT=5447
PAYMENT_DB_NAME=CARECONNECT_PAYMENT
PAYMENT_DB_URL=jdbc:postgresql://localhost:5447/CARECONNECT_PAYMENT
PAYMENT_DB_USERNAME=postgres
PAYMENT_DB_PASSWORD=postgres

PAYMENT_JWT_ISSUER=careconnect-identity
PAYMENT_JWT_JWKS_URI=http://localhost:8081/.well-known/jwks.json
PAYMENT_IDENTITY_URL=http://localhost:8080
PAYMENT_BOOKING_URL=http://localhost:8080
PAYMENT_SERVICE_CLIENT_ID=payment
PAYMENT_SERVICE_CLIENT_SECRET=replace-with-identity-service-client-secret

# D17: % cọc thật nằm ở platform_policies (seed GLOBAL 30); biến này chỉ để cảnh báo khi lệch.
PAYMENT_DEPOSIT_PERCENT=30

VNPAY_ENABLED=true
VNPAY_TMN_CODE=replace-with-vnpay-sandbox-tmn-code
VNPAY_HASH_SECRET=replace-with-vnpay-sandbox-hash-secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Trình duyệt quay về trang FE; trang đó gọi GET /api/v1/payments/vnpay/return để kiểm chữ ký.
VNPAY_RETURN_URL=http://localhost:5173/customer/payments/vnpay-return
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_SERVER_IP=127.0.0.1
# Job hết hạn phiên hỏi lại VNPay (querydr) trước khi đánh EXPIRED — bật khi đã có TMN thật / sandbox.
VNPAY_QUERYDR_ENABLED=false

# SIMULATED (mặc định, không gọi VNPay) | VNPAY (gọi API refund thật — chưa kiểm sandbox, Đợt 1b)
PAYMENT_REFUND_MODE=SIMULATED
PAYMENT_REFUND_SCAN_INTERVAL=30s
PAYMENT_REFUND_MAX_ATTEMPTS=5
PAYMENT_REFUND_BACKOFF_BASE=1m
PAYMENT_REFUND_BACKOFF_MAX=1h
PAYMENT_INVOICE_OVERDUE_SCAN_INTERVAL=10m

# Outbox xác nhận cọc sang Booking + job phiên quá hạn (Đợt 1b)
PAYMENT_OUTBOX_SCAN_INTERVAL=30s
PAYMENT_OUTBOX_MAX_ATTEMPTS=10
PAYMENT_EXPIRY_SCAN_INTERVAL=5m
PAYMENT_EXPIRY_GRACE=5m

# D16: chỉ VNPay; Stripe tắt (gateway không mở path Stripe).
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_SUCCESS_URL=http://localhost:8087/api/v1/payments/stripe/return?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel
